# Used by Next.js on the server to configure the same-origin /api rewrite.
# Vercel: set this (without NEXT_PUBLIC_) to the public Render API origin,
# for example https://cruxer-api.onrender.com. Do not append a slash.
API_ORIGIN=http://localhost:4000

# Leave NEXT_PUBLIC_API_URL unset in production: browser requests should use the
# /api rewrite so the httpOnly session cookie remains first-party. It is only
# useful for an intentional direct API connection during local development.
# NEXT_PUBLIC_API_URL=
