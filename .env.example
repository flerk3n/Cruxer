# Shared runtime
NODE_ENV=development

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI='mongodb+srv://username:password@cluster.example.mongodb.net/cruxer?retryWrites=true&w=majority'
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_TTL_DAYS=7

# LLM and research providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 4500 keeps a free-tier key under its quota. On a paid Gemini tier (required for launch) use ~500.
GEMINI_MIN_REQUEST_INTERVAL_MS=4500
TAVILY_API_KEY=

# Quick Mock Interview, a Pro feature (server-only; never expose these to the browser).
# Set the ElevenLabs agent's max conversation duration to 600 seconds.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Billing: Dodo Payments. Required in production unless BILLING_ENABLED=false.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRO_PRODUCT_ID=

# Signup protection: Resend (verification email) and Cloudflare Turnstile. Required in production.
RESEND_API_KEY=
EMAIL_FROM=Cruxer <hello@your-domain.com>
TURNSTILE_SECRET_KEY=
# Web (public) values
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Local development only:
# REQUIRE_EMAIL_VERIFICATION=true
# DEV_GRANT_PRO=true

# Retrieval limits (safe defaults for local development)
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=1000000
