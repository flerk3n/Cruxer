# Shared runtime
NODE_ENV=development

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI='mongodb+srv://username:password@cluster.example.mongodb.net/cruxer?retryWrites=true&w=majority'
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_TTL_DAYS=7

# LLM and research providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Keep below the Flash-Lite free-tier request quota. Increase only for a paid plan.
GEMINI_MIN_REQUEST_INTERVAL_MS=4500
TAVILY_API_KEY=

# Optional: Quick Mock Interview (server-only; never expose these to the browser)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Retrieval limits (safe defaults for local development)
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=1000000
