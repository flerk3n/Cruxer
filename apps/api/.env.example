# Required outside test environments. Use a least-privilege MongoDB Atlas URI.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/cruxer?retryWrites=true&w=majority

# Required in production; generate at least 32 random bytes (for example: openssl rand -base64 48).
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# The deployed web origin permitted to send credentialed requests to this API.
WEB_ORIGIN=http://localhost:3000

# Optional local defaults.
PORT=4000
NODE_ENV=development
JWT_TTL_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_NAME=cruxer_session

# Generation and public-discussion research. Both are server-only secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Minimum time between Gemini request starts. Keep this at the free-tier-safe default unless your plan permits more.
GEMINI_MIN_REQUEST_INTERVAL_MS=4500
TAVILY_API_KEY=

# Billing: Dodo Payments (merchant of record). Required in production unless BILLING_ENABLED=false.
# Create a "Cruxer Pro" subscription product ($9/month, no trial) and a webhook pointing at
# https://<web-domain>/api/billing/webhook in the Dodo dashboard.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRO_PRODUCT_ID=
# BILLING_ENABLED=false

# Signup protection. Both are required in production.
RESEND_API_KEY=
EMAIL_FROM=Cruxer <hello@your-domain.com>
TURNSTILE_SECRET_KEY=

# Local development only (rejected or ignored in production):
# REQUIRE_EMAIL_VERIFICATION=true   # exercise the verification flow locally
# DEV_GRANT_PRO=true                # treat every local user as Pro (e.g. to test voice mocks)

# Optional: Quick Mock Interview (Pro). Set the agent's max conversation duration to 600 seconds.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
