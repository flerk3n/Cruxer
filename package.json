{
  "name": "cruxer",
  "version": "0.1.0",
  "private": true,
  "description": "An AI interview preparation kit builder.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "evaluate": "tsx scripts/evaluate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:shared": "tsc --noEmit",
    "typecheck": "npm run typecheck:shared && npm run typecheck --workspace @cruxer/api && npm run typecheck --workspace @cruxer/web",
    "lint": "npm run typecheck"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
